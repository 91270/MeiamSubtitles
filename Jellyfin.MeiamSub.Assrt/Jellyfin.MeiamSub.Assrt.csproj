<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.0.17.1</Version>
    <AssemblyVersion>1.0.17.1</AssemblyVersion>
    <FileVersion>1.0.17.1</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\Release</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 使用已验证的最低兼容基线，保持同一 DLL 可运行于 Jellyfin 10.10.7、10.11.11 和 12.1。 -->
    <PackageReference Include="Jellyfin.Controller" Version="10.10.7" />
    <PackageReference Include="SharpCompress" Version="0.50.1" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Update="thumb.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(SolutionDir)$(ConfigurationName)\" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(PkgSharpCompress)\lib\net8.0\SharpCompress.dll" DestinationFolder="$(SolutionDir)$(ConfigurationName)\dependencies\Jellyfin\" SkipUnchangedFiles="true" />
  </Target>

</Project>
